# Fill from a read-only survey of the existing VPS; no defaults imply spare capacity.
# Exact immutable image refs must end with @sha256:<64 lowercase hex digits>.
TD_NODE_IMAGE=
TD_POSTGRES_IMAGE=
TD_GATEWAY_HOST_PORT=
TD_RELEASES_DIR=/opt/last-throne/releases
TD_STATE_DIR=/opt/last-throne/state
TD_POSTGRES_PASSWORD=
# Create a dedicated application role separately from the database owner before exposure.
TD_DATABASE_URL=
TD_DATABASE_MIGRATION_URL=
TD_PG_POOL_MAX=
# Exact HTTPS origin for request Origin validation (recommended when routing/custom ports require it).
TD_PUBLIC_ORIGIN=
TD_RUNTIME_MEMORY_LIMIT=
TD_RUNTIME_CPU_LIMIT=
TD_PG_MEMORY_LIMIT=
TD_PG_CPU_LIMIT=
