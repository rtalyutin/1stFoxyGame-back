      "responseSchema": "RunTicket",
      "successStatus": 201,
      "requiresSession": true,
      "requiresCsrf": true
    },
    "/api/v1/runs/finish": {
      "method": "POST",
      "release": "R3",
      "implemented": false,
      "requestSchema": "RunFinishRequest",
      "responseSchema": "Profile",
      "successStatus": 200,
      "requiresSession": true,
      "requiresCsrf": true
    }
  },
  "x-internal-contracts": {
    "RunLedger": {
      "release": "R2",
      "publicHttpEndpoint": false,
      "eventBatchSchema": "InternalRunEventBatch",
      "ownership": "Trusted caller supplies authenticated account subject; no unauthenticated accountId route.",
      "guarantees": [
        "runId and server-generated seed bound to account and catalog/rules versions",
        "stable enemyId and ordered castId",
        "atomic bounded batches with canonical payload deduplication",
        "one enemy hit per cast and three distinct casts for the R2 boss",
        "terminal runs reject new events and all reward payloads"
      ],
      "limits": [
        "In-memory technical ledger; process restart loses runs.",
        "Client-authoritative R2 events are not geometry verification, anti-cheat, persistence or economic reward authorization.",
        "R3 must add authenticated durable run/economy transaction before exposing mutation endpoints."
      ]
    }
  }
}
